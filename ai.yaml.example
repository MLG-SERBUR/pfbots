ai:
  # All providers are optional; a provider is skipped entirely when its API key
  # is blank. Keys can also come from env vars: CEREBRAS_API_KEY, GROQ_API_KEY,
  # OPENROUTER_API_KEY, GEMINI_API_KEY, MISTRAL_API_KEY, ZAI_API_KEY,
  # CLOUDFLARE_API_KEY, CLOUDFLARE_ACCOUNT_ID, OLLAMA_API_KEY, ARLI_API_KEY / ARLIAI_API_KEY.
  #
  # Free-tier registration links:
  #   Cerebras:   https://cloud.cerebras.ai            (payment method now required)
  #   Groq:       https://console.groq.com/keys        (free, no card)
  #   OpenRouter: https://openrouter.ai/settings/keys  (free, no card)
  #   Gemini:     https://aistudio.google.com/apikey   (free tier, no card)
  #   Mistral:    https://console.mistral.ai           (free Experiment tier, phone verification)
  #   Z.AI:       https://z.ai/manage-apikey/apikey-list (GLM Flash models free, no card)
  #   Cloudflare: https://dash.cloudflare.com/profile/api-tokens (Workers AI free allocation, no card;
  #               Account ID is shown on the Cloudflare dashboard home)
  #   Ollama:     https://ollama.com/settings/keys     (free plan, no card)
  #   SambaNova:  https://cloud.sambanova.ai/apis      (free tier 20 req/day, no card)
  #   ArliAI:     https://arliai.com/                  (used for reaction selection, separate timeout)
  #
  # Models are configured in code (GenerativeAiConfig). YAML only stores secret tokens.
  cerebrasApiKey: ""
  groqApiKey: ""
  openrouterApiKey: ""
  geminiApiKey: ""
  mistralApiKey: ""
  zaiApiKey: ""
  cloudflareApiKey: ""
  cloudflareAccountId: ""
  ollamaApiKey: ""
  sambaNovaApiKey: ""
  arliApiKey: ""
